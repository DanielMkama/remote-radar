# Supabase project credentials.
# Find these in your Supabase project: Settings -> API.
# Copy this file to .env.local and fill in real values — never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, bypasses Row Level Security.
# Used by ingestion/admin code (added in a later phase). Never expose this
# to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
