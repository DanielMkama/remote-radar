# Supabase project credentials.
# Find these in your Supabase project: Settings -> API.
# Copy this file to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - server-side only, bypasses Row Level Security.
# Used by ingestion (npm run ingest) and the API routes under /api.
# Never expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/ingest (triggers an ingestion run over HTTP).
# Leave unset to keep that endpoint disabled; use `npm run ingest` instead
# for local/manual runs, which doesn't need this. If set, callers must
# send it back as the `x-ingest-secret` request header. Generate one with
# `openssl rand -hex 32` or similar - never reuse a real secret here.
INGEST_SECRET=
